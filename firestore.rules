rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    match /directory/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /users/{uid} {
      // Perfis de terceiros só são fornecidos pela API após verificar conversa em comum.
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
      match /devices/{deviceId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      match /installations/{id} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['id'])
          && request.resource.data.id is string && request.resource.data.id.size() == 36;
      }
    }
    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }
    match /directConversations/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
