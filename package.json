{
  "name": "conecta-chat",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace server",
    "test": "vitest run tests/domain.test.ts tests/api.test.ts",
    "test:rules": "firebase emulators:exec --only auth,firestore,database,storage --project demo-conecta \"vitest run tests/rules.test.ts\"",
    "test:integration": "firebase emulators:exec --only auth,firestore,database,storage --project demo-conecta \"vitest run tests/integration.test.ts\"",
    "server:dev": "npm run dev --workspace server",
    "server:build": "npm run build --workspace server",
    "check:delivery": "node scripts/check-delivery.mjs"
  },
  "dependencies": {
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/auth": "26.4.0",
    "@react-native-firebase/database": "26.4.0",
    "@react-native-firebase/firestore": "26.4.0",
    "@react-native-firebase/messaging": "26.4.0",
    "@react-native-firebase/storage": "26.4.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "expo": "~55.0.31",
    "expo-build-properties": "~55.0.0",
    "expo-crypto": "~55.0.0",
    "expo-dev-client": "~55.0.0",
    "expo-image-picker": "~55.0.0",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "~19.2.2",
    "@types/supertest": "^6.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^14.0.0",
    "prettier": "^3.9.9",
    "supertest": "^7.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.0"
  }
}
